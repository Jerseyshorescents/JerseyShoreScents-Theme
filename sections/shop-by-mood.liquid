<section class="section section--white">
  <div class="page-width">
    <div class="section-heading"><p class="eyebrow eyebrow--dark">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2></div>
    <div class="mood-grid">
      {% for block in section.blocks %}
        <a class="mood-card" href="{{ block.settings.link | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>
          <span class="mood-card__icon" aria-hidden="true">{{ block.settings.icon }}</span>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </a>
      {% endfor %}
    </div>
  </div>
</section>
{% schema %}
{
  "name":"Shop by mood",
  "max_blocks":6,
  "settings":[
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"Find your feeling"},
    {"type":"text","id":"heading","label":"Heading","default":"Shop by Mood"}
  ],
  "blocks":[{"type":"mood","name":"Mood","settings":[
    {"type":"text","id":"icon","label":"Icon or symbol","default":"〰"},
    {"type":"text","id":"title","label":"Title","default":"Fresh & Coastal"},
    {"type":"textarea","id":"text","label":"Description","default":"Clean, airy scents inspired by saltwater and sea breeze."},
    {"type":"url","id":"link","label":"Link"}
  ]}],
  "presets":[{"name":"Shop by mood","blocks":[
    {"type":"mood","settings":{"icon":"〰","title":"Fresh & Coastal","text":"Clean, airy scents inspired by saltwater and sea breeze."}},
    {"type":"mood","settings":{"icon":"✦","title":"Sweet & Gourmand","text":"Comforting notes of vanilla, caramel, and delicious treats."}},
    {"type":"mood","settings":{"icon":"❀","title":"Floral","text":"Soft blossoms, romantic bouquets, and timeless femininity."}},
    {"type":"mood","settings":{"icon":"◌","title":"Fruity & Citrus","text":"Bright, juicy, uplifting scents with a sparkling finish."}},
    {"type":"mood","settings":{"icon":"◆","title":"Masculine","text":"Confident woods, spice, clean musk, and fresh cologne notes."}},
    {"type":"mood","settings":{"icon":"☼","title":"Warm & Cozy","text":"Soft amber, warm woods, and scents made for slow evenings."}}
  ]}]
}
{% endschema %}
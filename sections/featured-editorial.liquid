{% assign product = section.settings.product %}
<section class="section section--sand">
  <div class="page-width editorial">
    <div class="editorial__media">
      {% assign image = section.settings.image | default: product.featured_image %}
      {% if image != blank %}
        {{ image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '600, 900, 1200, 1400', sizes: '(min-width: 990px) 50vw, 100vw', alt: section.settings.heading }}
      {% else %}
        {{ 'product-2' | placeholder_svg_tag }}
      {% endif %}
    </div>
    <div class="editorial__content">
      <p class="eyebrow eyebrow--dark">{{ section.settings.eyebrow }}</p>
      <h2>{{ section.settings.heading }}</h2>
      <div class="rte">{{ section.settings.text }}</div>
      {% if product != blank %}<p class="editorial__price">{{ product.price | money }}</p>{% endif %}
      <a class="button button--primary" href="{{ section.settings.link | default: product.url | default: routes.all_products_collection_url }}">{{ section.settings.button_label }}</a>
    </div>
  </div>
</section>
{% schema %}
{
  "name":"Featured editorial",
  "settings":[
    {"type":"product","id":"product","label":"Product"},
    {"type":"image_picker","id":"image","label":"Custom image"},
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"A little glow, bottled"},
    {"type":"text","id":"heading","label":"Heading","default":"Featured Shimmer Body Oils"},
    {"type":"richtext","id":"text","label":"Text","default":"<p>Silky, lightweight moisture with a luminous finish. Made for sun-kissed skin, date nights, and every moment that deserves a little extra glow.</p>"},
    {"type":"text","id":"button_label","label":"Button label","default":"Shop Shimmer Oils"},
    {"type":"url","id":"link","label":"Custom link"}
  ],
  "presets":[{"name":"Featured editorial"}]
}
{% endschema %}
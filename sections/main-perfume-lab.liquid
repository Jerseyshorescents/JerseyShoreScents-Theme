<section class="lab-page">
  <div class="lab-hero"><div class="page-width"><span class="lab-wave">≈</span><p class="eyebrow eyebrow--dark">{{ section.settings.eyebrow }}</p><h1>{{ section.settings.heading }}</h1><div class="rte">{{ section.settings.intro }}</div>{% if section.settings.product != blank %}<a class="button button--primary" href="{{ section.settings.product.url }}">{{ section.settings.button_label }}</a>{% endif %}</div></div>
  <div class="page-width lab-body">
    <div class="lab-steps">
      <article><b>01</b><h2>Choose Your Scents</h2><p>Select two or three fragrances from the available scent library.</p></article>
      <article><b>02</b><h2>Set Your Blend</h2><p>Choose a balanced blend or make one fragrance more dominant.</p></article>
      <article><b>03</b><h2>We Create It</h2><p>Your custom 50 ml Eau de Parfum is handcrafted from your selections.</p></article>
    </div>
    <div class="lab-library"><p class="eyebrow eyebrow--dark">Explore the possibilities</p><h2>{{ section.settings.library_heading }}</h2><div class="lab-scents">{% for block in section.blocks %}<article {{ block.shopify_attributes }}><h3>{{ block.settings.name }}</h3><div class="rte">{{ block.settings.notes }}</div></article>{% endfor %}</div></div>
    <aside class="lab-note"><h2>Before You Blend</h2><div class="rte">{{ section.settings.disclaimer }}</div>{% if section.settings.product != blank %}<a class="button button--primary" href="{{ section.settings.product.url }}">{{ section.settings.button_label }}</a>{% endif %}</aside>
  </div>
</section>
<style>
.lab-page{background:#fffaf3;color:#1f2a33}.lab-hero{padding:clamp(4rem,9vw,7rem) 0;background:linear-gradient(135deg,#f4eadc,#fffaf3 52%,#e5d4bd);text-align:center}.lab-wave{display:block;color:#6d91a8;font-size:2.2rem}.lab-hero h1{margin:.2rem 0 1rem;color:#16324a;font-size:clamp(3.5rem,8vw,6rem)}.lab-hero .rte{max-width:690px;margin:0 auto 1.7rem}.lab-body{padding-block:clamp(3rem,7vw,6rem)}.lab-steps{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.lab-steps article,.lab-scents article{padding:1.5rem;border:1px solid rgba(22,50,74,.11);border-radius:20px;background:#fff}.lab-steps b{color:#6d91a8;letter-spacing:.12em}.lab-steps h2{margin:.45rem 0;color:#16324a;font-size:1.65rem}.lab-steps p{margin:0;color:#59636b}.lab-library{margin-top:clamp(3rem,7vw,5rem);text-align:center}.lab-library>h2{margin:.2rem 0 1.5rem;color:#16324a;font-size:clamp(2.5rem,5vw,4rem)}.lab-scents{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;text-align:left}.lab-scents h3{margin:0 0 .65rem;color:#16324a;font-size:1.6rem}.lab-scents .rte{color:#59636b;font-size:.94rem}.lab-note{margin:4rem auto 0;max-width:850px;padding:clamp(1.5rem,4vw,2.5rem);border-radius:24px;background:#f4eadc;text-align:center}.lab-note h2{margin-top:0;color:#16324a}.lab-note .button{margin-top:1rem}@media(max-width:749px){.lab-steps,.lab-scents{grid-template-columns:1fr}.lab-hero{padding:3.5rem 0}.lab-note{border-radius:18px}}
</style>
{% schema %}
{"name":"The Perfume Lab","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Create something uniquely yours"},{"type":"text","id":"heading","label":"Heading","default":"The Perfume Lab"},{"type":"richtext","id":"intro","label":"Introduction","default":"<p>Choose two or three fragrances and create a custom 50 ml blend made especially for you.</p>"},{"type":"text","id":"library_heading","label":"Library heading","default":"Fragrance Library"},{"type":"product","id":"product","label":"Custom perfume product"},{"type":"text","id":"button_label","label":"Button label","default":"Create Your Blend"},{"type":"richtext","id":"disclaimer","label":"Disclaimer","default":"<p>Fragrances can change when blended and may develop differently with individual skin chemistry. Custom perfumes are made to order and are final sale.</p>"}],"blocks":[{"type":"scent","name":"Scent","settings":[{"type":"text","id":"name","label":"Scent name","default":"Placeholder Scent"},{"type":"richtext","id":"notes","label":"Scent notes","default":"<p>Add the scent description here.</p>"}]}],"presets":[{"name":"The Perfume Lab"}]}
{% endschema %}
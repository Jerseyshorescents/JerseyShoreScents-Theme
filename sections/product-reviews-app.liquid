{% if section.blocks.size > 0 %}
  <section class="product-reviews-app">
    <div class="page-width">
      {% if section.settings.eyebrow != blank or section.settings.heading != blank %}
        <div class="section-heading">
          {% if section.settings.eyebrow != blank %}<p class="eyebrow eyebrow--dark">{{ section.settings.eyebrow }}</p>{% endif %}
          {% if section.settings.heading != blank %}<h2>{{ section.settings.heading }}</h2>{% endif %}
        </div>
      {% endif %}

      <div class="product-reviews-app__content">
        {% content_for 'blocks' %}
      </div>
    </div>
  </section>
{% endif %}

<style>
  .product-reviews-app {
    padding: clamp(3.5rem, 7vw, 6rem) 0;
    background: #fff;
  }

  .product-reviews-app .section-heading {
    margin-bottom: 2rem;
  }

  .product-reviews-app__content {
    max-width: 1050px;
    margin-inline: auto;
  }
</style>

{% schema %}
{
  "name": "Product reviews",
  "settings": [
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"From our customers"},
    {"type":"text","id":"heading","label":"Heading","default":"Reviews for This Product"}
  ],
  "blocks": [
    {"type":"@app"}
  ],
  "presets": [
    {"name":"Product reviews"}
  ]
}
{% endschema %}
{% assign collection = section.settings.collection %}
<section class="section section--cream featured-collection">
  <div class="page-width">
    <div class="section-heading section-heading--split">
      <div><p class="eyebrow eyebrow--dark">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2></div>
      {% if collection != blank %}<a class="text-link" href="{{ collection.url }}">View all <span aria-hidden="true">→</span></a>{% endif %}
    </div>
    <div class="product-grid">
      {% if collection != blank and collection.products_count > 0 %}
        {% for product in collection.products limit: section.settings.products_to_show %}
          <article class="product-card">
            <a href="{{ product.url }}" class="product-card__media">
              {% if product.featured_image != blank %}{{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360, 540, 720, 900', sizes: '(min-width: 990px) 25vw, 50vw', alt: product.title }}{% endif %}
            </a>
            <div class="product-card__content"><h3><a href="{{ product.url }}">{{ product.title }}</a></h3><p>{{ product.price | money }}</p></div>
          </article>
        {% endfor %}
      {% else %}
        {% for i in (1..4) %}<article class="product-card"><div class="product-card__media">{{ 'product-' | append: i | placeholder_svg_tag }}</div><div class="product-card__content"><h3>Best seller</h3><p>$0.00</p></div></article>{% endfor %}
      {% endif %}
    </div>
  </div>
</section>
<style>
  @media screen and (max-width: 749px) {
    .featured-collection .product-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.65rem;
    }

    .featured-collection .product-card {
      border-radius: 16px;
    }

    .featured-collection .product-card__content {
      padding: 0.75rem 0.8rem 0.9rem;
    }

    .featured-collection .product-card h3 {
      font-size: 1.05rem;
      line-height: 1.15;
    }

    .featured-collection .product-card p {
      font-size: 0.9rem;
    }
  }
</style>

{% schema %}
{
  "name":"Featured collection",
  "settings":[
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"Loved by the shore"},
    {"type":"text","id":"heading","label":"Heading","default":"Best Sellers"},
    {"type":"collection","id":"collection","label":"Collection"},
    {"type":"range","id":"products_to_show","label":"Products to show","min":2,"max":8,"step":1,"default":4}
  ],
  "presets":[{"name":"Featured collection"}]
}
{% endschema %}
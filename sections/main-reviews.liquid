<section class="reviews-page" id="ReviewsSection-{{ section.id }}">
  <header class="reviews-hero">
    <div class="page-width">
      <div class="reviews-hero__wave" aria-hidden="true">≈</div>
      <p class="eyebrow eyebrow--dark">{{ section.settings.eyebrow }}</p>
      <h1>{{ section.settings.heading }}</h1>
      <div class="reviews-hero__text rte">{{ section.settings.intro }}</div>
    </div>
  </header>

  <div class="page-width reviews-content">
    {% if section.blocks.size > 0 %}
      <div class="reviews-app">
        {% for block in section.blocks %}
          {% render block %}
        {% endfor %}
      </div>
    {% elsif request.design_mode %}
      <div class="reviews-app-placeholder">
        <h2>Add your Judge.me reviews</h2>
        <p>Click “Add block,” open the Apps tab, and select the Judge.me Reviews Grid.</p>
      </div>
    {% endif %}
  </div>
</section>

<style>
  .reviews-page { min-height: 65vh; background: #fffaf3; }
  .reviews-hero { padding: clamp(3.75rem, 8vw, 6rem) 0; background: linear-gradient(135deg, #f4eadc 0%, #fffaf3 52%, #e5d4bd 100%); text-align: center; }
  .reviews-hero__wave { margin-bottom: .25rem; color: #6d91a8; font-size: 2.2rem; line-height: 1; }
  .reviews-hero h1 { margin: .25rem 0 .85rem; color: #16324a; font-size: clamp(3.25rem, 7vw, 5.5rem); }
  .reviews-hero__text { max-width: 650px; margin-inline: auto; color: rgba(31, 42, 51, .72); font-size: 1.05rem; }
  .reviews-hero__text p { margin: 0; }
  .reviews-content { padding-block: clamp(3rem, 7vw, 6rem); }
  .reviews-app { max-width: 1100px; margin-inline: auto; }
  .reviews-app-placeholder { max-width: 760px; margin-inline: auto; padding: 3rem 1.5rem; border: 2px dashed rgba(109, 145, 168, .4); border-radius: 20px; background: #fff; text-align: center; }
  .reviews-app-placeholder h2 { margin: 0 0 .5rem; color: #16324a; font-size: clamp(2rem, 4vw, 2.75rem); }
  .reviews-app-placeholder p { margin: 0; color: rgba(31, 42, 51, .7); }
  .reviews-page .jdgm-widget { color: #1f2a33; }
  .reviews-page .jdgm-rev-widg__title,
  .reviews-page .jdgm-all-reviews-page__title { color: #16324a; font-family: "Cormorant Garamond", Georgia, serif; }
  .reviews-page .jdgm-star { color: #6d91a8 !important; }
  .reviews-page .jdgm-btn,
  .reviews-page .jdgm-write-rev-link { border-color: #16324a !important; background: #16324a !important; color: #fff !important; border-radius: 999px !important; }
  @media screen and (max-width: 749px) {
    .reviews-hero { padding: 3.5rem 0; }
    .reviews-content { padding-block: 2.5rem; }
  }
</style>

{% schema %}
{
  "name": "Reviews page",
  "settings": [
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"Kind words from customers"},
    {"type":"text","id":"heading","label":"Heading","default":"Customer Reviews"},
    {"type":"richtext","id":"intro","label":"Introduction","default":"<p>See what customers are saying about their JerseyShoreScents favorites.</p>"}
  ],
  "blocks": [
    {"type":"@app"}
  ],
  "presets": [
    {"name":"Reviews page"}
  ]
}
{% endschema %}
{% paginate search.results by section.settings.results_per_page %}
  <section class="search-page">
    <div class="page-width">
      <header class="search-header">
        <p class="eyebrow eyebrow--dark">{{ section.settings.eyebrow }}</p>
        <h1>{{ section.settings.heading }}</h1>

        <form class="search-form" action="{{ routes.search_url }}" method="get" role="search">
          <label class="visually-hidden" for="SearchInput-{{ section.id }}">Search the store</label>
          <input id="SearchInput-{{ section.id }}" type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search perfumes, body care, and more" autocomplete="off">
          <input type="hidden" name="options[prefix]" value="last">
          <button class="button button--primary" type="submit">Search</button>
        </form>
      </header>

      {% if search.performed %}
        {% if search.results_count > 0 %}
          <div class="search-summary">
            <p>{{ search.results_count }} {% if search.results_count == 1 %}result{% else %}results{% endif %} for “{{ search.terms | escape }}”</p>
          </div>

          <div class="search-results">
            {% for item in search.results %}
              {% case item.object_type %}
                {% when 'product' %}
                  <article class="search-card search-card--product">
                    <a class="search-card__media" href="{{ item.url }}">
                      {% if item.featured_image != blank %}
                        {{ item.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '240, 360, 540, 720, 800', sizes: '(min-width: 990px) 25vw, 50vw', alt: item.title }}
                      {% else %}
                        {{ 'product-1' | placeholder_svg_tag }}
                      {% endif %}
                      {% unless item.available %}<span class="search-card__badge">Sold out</span>{% endunless %}
                    </a>
                    <div class="search-card__content">
                      <p class="search-card__type">Product</p>
                      <h2><a href="{{ item.url }}">{{ item.title }}</a></h2>
                      <div class="search-card__price">
                        {% if item.price_varies %}<span>From </span>{% endif %}{{ item.price | money }}
                        {% if item.compare_at_price > item.price %}<s>{{ item.compare_at_price | money }}</s>{% endif %}
                      </div>
                    </div>
                  </article>

                {% when 'article' %}
                  <article class="search-card search-card--content">
                    {% if item.image != blank %}
                      <a class="search-card__media search-card__media--article" href="{{ item.url }}">
                        {{ item.image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '360, 540, 720, 800', sizes: '(min-width: 990px) 33vw, 100vw', alt: item.title }}
                      </a>
                    {% endif %}
                    <div class="search-card__content">
                      <p class="search-card__type">Article</p>
                      <h2><a href="{{ item.url }}">{{ item.title }}</a></h2>
                      {% if item.excerpt_or_content != blank %}<p class="search-card__excerpt">{{ item.excerpt_or_content | strip_html | truncatewords: 24 }}</p>{% endif %}
                      <a class="text-link" href="{{ item.url }}">Read more →</a>
                    </div>
                  </article>

                {% when 'page' %}
                  <article class="search-card search-card--content">
                    <div class="search-card__content">
                      <p class="search-card__type">Page</p>
                      <h2><a href="{{ item.url }}">{{ item.title }}</a></h2>
                      {% if item.content != blank %}<p class="search-card__excerpt">{{ item.content | strip_html | truncatewords: 24 }}</p>{% endif %}
                      <a class="text-link" href="{{ item.url }}">View page →</a>
                    </div>
                  </article>
              {% endcase %}
            {% endfor %}
          </div>

          {% if paginate.pages > 1 %}
            <nav class="search-pagination" aria-label="Search results pagination">
              {% if paginate.previous %}<a href="{{ paginate.previous.url }}">← Previous</a>{% endif %}
              <span>Page {{ paginate.current_page }} of {{ paginate.pages }}</span>
              {% if paginate.next %}<a href="{{ paginate.next.url }}">Next →</a>{% endif %}
            </nav>
          {% endif %}
        {% else %}
          <div class="search-empty">
            <div class="search-empty__icon" aria-hidden="true">≈</div>
            <h2>No results found</h2>
            <p>We couldn’t find anything for “{{ search.terms | escape }}.” Try another scent, product type, or keyword.</p>
            <a class="button button--primary" href="{{ routes.all_products_collection_url }}">Shop all products</a>
          </div>
        {% endif %}
      {% else %}
        <div class="search-prompt">
          <p>Search by scent name, product type, fragrance note, or collection.</p>
        </div>
      {% endif %}
    </div>
  </section>
{% endpaginate %}

<style>
  .visually-hidden { position: absolute !important; width: 1px !important; height: 1px !important; padding: 0 !important; margin: -1px !important; overflow: hidden !important; clip: rect(0, 0, 0, 0) !important; white-space: nowrap !important; border: 0 !important; }
  .search-page { min-height: 65vh; padding: clamp(3rem, 7vw, 6rem) 0; background: linear-gradient(135deg, #fffaf3, #f7f2e8); }
  .search-header { max-width: 800px; margin: 0 auto clamp(2.5rem, 5vw, 4rem); text-align: center; }
  .search-header h1 { margin: .2rem 0 1.5rem; color: #16324a; font-size: clamp(3rem, 6vw, 5rem); }
  .search-form { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: .7rem; padding: .45rem; border: 1px solid rgba(22, 50, 74, .15); border-radius: 999px; background: #fff; box-shadow: 0 12px 30px rgba(22, 50, 74, .08); }
  .search-form input[type='search'] { min-width: 0; padding: .65rem 1rem; border: 0; outline: 0; background: transparent; color: #16324a; }
  .search-form .button { min-height: 45px; }
  .search-summary { margin-bottom: 1.5rem; padding-bottom: 1rem; border-bottom: 1px solid rgba(22, 50, 74, .13); color: rgba(31, 42, 51, .7); }
  .search-summary p { margin: 0; }
  .search-results { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(1rem, 2vw, 1.5rem); }
  .search-card { overflow: hidden; border-radius: 20px; background: #fff; box-shadow: 0 14px 32px rgba(22, 50, 74, .09); }
  .search-card__media { position: relative; display: block; aspect-ratio: 4 / 5; overflow: hidden; background: #eee; }
  .search-card__media--article { aspect-ratio: 16 / 10; }
  .search-card__media img, .search-card__media svg { width: 100%; height: 100%; object-fit: cover; transition: transform .35s ease; }
  .search-card:hover .search-card__media img { transform: scale(1.03); }
  .search-card__badge { position: absolute; top: .7rem; left: .7rem; padding: .35rem .65rem; border-radius: 999px; background: #16324a; color: #fff; font-size: .68rem; font-weight: 700; letter-spacing: .07em; text-transform: uppercase; }
  .search-card__content { padding: 1rem 1rem 1.2rem; }
  .search-card__type { margin: 0 0 .35rem; color: #6d91a8; font-size: .7rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
  .search-card h2 { margin: 0 0 .5rem; color: #16324a; font-size: 1.35rem; line-height: 1.15; }
  .search-card h2 a { text-decoration: none; }
  .search-card__price { color: #16324a; font-weight: 700; }
  .search-card__price s { margin-left: .4rem; color: rgba(31, 42, 51, .48); font-weight: 400; }
  .search-card__excerpt { color: rgba(31, 42, 51, .7); font-size: .9rem; }
  .search-card--content { grid-column: span 2; }
  .search-pagination { display: flex; justify-content: center; align-items: center; gap: 1.25rem; margin-top: 3rem; }
  .search-pagination a { color: #16324a; font-weight: 700; text-decoration: none; }
  .search-empty, .search-prompt { max-width: 620px; margin: 0 auto; padding: clamp(2.5rem, 6vw, 5rem) 1rem; text-align: center; }
  .search-empty__icon { color: #6d91a8; font-size: 3rem; }
  .search-empty h2 { margin: .4rem 0; color: #16324a; font-size: clamp(2.3rem, 5vw, 3.5rem); }
  .search-empty p, .search-prompt { color: rgba(31, 42, 51, .7); }
  @media screen and (max-width: 989px) { .search-results { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media screen and (max-width: 749px) {
    .search-results { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .7rem; }
    .search-card { border-radius: 15px; }
    .search-card__content { padding: .75rem .75rem .9rem; }
    .search-card h2 { font-size: 1.05rem; }
    .search-card--content { grid-column: 1 / -1; }
  }
  @media screen and (max-width: 480px) {
    .search-form { grid-template-columns: 1fr; border-radius: 20px; }
    .search-form .button { width: 100%; }
  }
</style>

{% schema %}
{
  "name": "Search results",
  "settings": [
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"Find your next favorite"},
    {"type":"text","id":"heading","label":"Heading","default":"Search JerseyShoreScents"},
    {"type":"range","id":"results_per_page","label":"Results per page","min":8,"max":40,"step":4,"default":20}
  ]
}
{% endschema %}
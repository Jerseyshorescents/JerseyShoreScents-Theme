<section class="section section--navy">
  <div class="page-width">
    <div class="section-heading section-heading--light"><p class="eyebrow">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2></div>
    <div class="testimonial-grid">
      {% for block in section.blocks %}
        <blockquote class="testimonial-card" {{ block.shopify_attributes }}>
          <div class="testimonial-card__stars" aria-label="5 out of 5 stars">★★★★★</div>
          <p>“{{ block.settings.quote }}”</p>
          <footer><strong>{{ block.settings.name }}</strong>{% if block.settings.product != blank %}<span>{{ block.settings.product }}</span>{% endif %}</footer>
        </blockquote>
      {% endfor %}
    </div>
  </div>
</section>
{% schema %}
{
  "name":"Testimonials",
  "max_blocks":6,
  "settings":[
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"From our customers"},
    {"type":"text","id":"heading","label":"Heading","default":"A Little Shore Love"}
  ],
  "blocks":[{"type":"testimonial","name":"Testimonial","settings":[
    {"type":"textarea","id":"quote","label":"Review","default":"The scent is beautiful and lasts for hours. Everything arrived packaged with so much care."},
    {"type":"text","id":"name","label":"Customer name","default":"Happy customer"},
    {"type":"text","id":"product","label":"Product","default":"Verified purchase"}
  ]}],
  "presets":[{"name":"Testimonials","blocks":[{"type":"testimonial"},{"type":"testimonial"},{"type":"testimonial"}]}]
}
{% endschema %}
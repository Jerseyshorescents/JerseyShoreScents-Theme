{% assign mood_names = 'Fresh & Coastal|Fruity & Citrus|Floral|Sweet & Gourmand|Warm & Cozy|Masculine' | split: '|' %}
<section class="section mood-catalog">
  <div class="page-width">
    {% for mood_name in mood_names %}
      <span class="mood-catalog__anchor" id="{{ mood_name | handleize }}" aria-hidden="true"></span>
    {% endfor %}
    <nav class="mood-catalog__nav mood-catalog__switcher" aria-label="Shop by mood">
      {% for mood_name in mood_names %}
        <a href="{{ collection.url | default: routes.all_products_collection_url }}?view=shop-by-mood#{{ mood_name | handleize }}">{{ mood_name | escape }}</a>
      {% endfor %}
    </nav>
    <div class="mood-catalog__groups">
      {% paginate collection.products by 250 %}
        {% for mood_name in mood_names %}
          {% assign mood_handle = mood_name | handleize %}
          {% assign found_products = false %}
          <section class="mood-catalog__group" data-mood="{{ mood_handle }}">
            <h1>{{ mood_name | escape }}</h1>
            <div class="mood-catalog__grid">
              {% for product in collection.products %}
                {% assign product_family = product.metafields.custom.scent_family.value | handleize %}
                {% if product_family == mood_handle %}
                  {% assign found_products = true %}
                  <article class="mood-catalog__card">
                    <a href="{{ product.url }}">
                      {% if product.featured_image %}
                        {{ product.featured_image | image_url: width: 640 | image_tag: loading: 'lazy', widths: '240, 480, 640', sizes: '(min-width: 990px) 25vw, 50vw', alt: '' }}
                      {% else %}
                        {{ 'product-1' | placeholder_svg_tag }}
                      {% endif %}
                      <h2>{{ product.title | escape }}</h2>
                    </a>
                    <p>{% if product.price_varies %}From {% endif %}{{ product.price | money }}</p>
                  </article>
                {% endif %}
              {% endfor %}
            </div>
            {% unless found_products %}<p>No products in this mood on this page.</p>{% endunless %}
            {% if paginate.pages > 1 %}
              <nav class="mood-catalog__nav" aria-label="Product pages">
                {% if paginate.previous %}<a href="{{ paginate.previous.url }}#{{ mood_handle }}">Previous</a>{% endif %}
                <span>Page {{ paginate.current_page }} of {{ paginate.pages }}</span>
                {% if paginate.next %}<a href="{{ paginate.next.url }}#{{ mood_handle }}">Next</a>{% endif %}
              </nav>
            {% endif %}
          </section>
        {% endfor %}
      {% endpaginate %}
      <p class="mood-catalog__prompt">Choose a mood to shop matching scents.</p>
    </div>
  </div>
</section>
<style>
  .mood-catalog__nav { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: .75rem 1.25rem; margin-block: 1rem 2rem; }
  .mood-catalog__nav a { text-decoration: underline; text-underline-offset: .2em; }
  .mood-catalog__anchor { display: block; scroll-margin-top: 1rem; }
  .mood-catalog__switcher { gap: .5rem; }
  .mood-catalog__switcher a {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    padding: .45rem .95rem;
    border: 1px solid #16324a;
    border-radius: 999px;
    color: #16324a;
    text-decoration: none;
  }
  .mood-catalog__switcher a:hover { background: #eaf1f5; }
  .mood-catalog__group { display: none; }
  .mood-catalog__anchor:target ~ .mood-catalog__groups .mood-catalog__prompt { display: none; }
  {% for mood_name in mood_names %}
    {% assign mood_handle = mood_name | handleize %}
    #{{ mood_handle }}:target ~ .mood-catalog__groups [data-mood="{{ mood_handle }}"] { display: block; }
    #{{ mood_handle }}:target ~ .mood-catalog__switcher a[href$="#{{ mood_handle }}"] { background: #16324a; color: #fff; }
  {% endfor %}
  .mood-catalog__group h1, .mood-catalog__prompt { text-align: center; }
  .mood-catalog__grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(1rem, 2vw, 1.5rem); }
  .mood-catalog__card { overflow: hidden; border-radius: 20px; background: #fff; box-shadow: 0 14px 32px rgba(22, 50, 74, .09); }
  .mood-catalog__card img, .mood-catalog__card svg { display: block; width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; }
  .mood-catalog__card h2 { margin: .85rem 1rem .25rem; font-size: 1.1rem; }
  .mood-catalog__card p { margin: 0 1rem 1rem; }
  @media (max-width: 749px) { .mood-catalog__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>
{% schema %}
{"name":"Mood products","settings":[]}
{% endschema %}

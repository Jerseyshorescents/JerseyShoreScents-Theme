<footer class="site-footer site-footer--expanded">
  <div class="page-width">
    <div class="footer-grid footer-grid--expanded">
      <div class="footer-brand">
        <h2 class="footer-brand__name">{{ section.settings.heading }}</h2>
        <div class="footer-brand__text">{{ section.settings.text }}</div>
        <p class="footer-brand__ownership">{{ section.settings.ownership_text }}</p>

        <ul class="footer-socials" aria-label="Social media">
          {% if settings.social_instagram_link != blank %}<li><a href="{{ settings.social_instagram_link }}">Instagram</a></li>{% endif %}
          {% if settings.social_facebook_link != blank %}<li><a href="{{ settings.social_facebook_link }}">Facebook</a></li>{% endif %}
          {% if settings.social_tiktok_link != blank %}<li><a href="{{ settings.social_tiktok_link }}">TikTok</a></li>{% endif %}
        </ul>
      </div>

      <nav class="footer-column" aria-label="Shop">
        <h2 class="footer-heading">Shop</h2>
        <ul class="footer-links">
          {% if section.settings.shop_menu != blank %}
            {% for link in section.settings.shop_menu.links %}
              {% assign footer_link_title = link.title | downcase %}
              <li>
                {% if footer_link_title == 'search' %}
                  <form class="footer-search-form" action="{{ routes.search_url }}" method="get" role="search">
                    <input id="FooterSearch-{{ section.id }}" type="search" name="q" placeholder="Search" autocomplete="off">
                    <button type="submit" aria-label="Submit search">⌕</button>
                  </form>
                {% else %}
                  <a href="{{ link.url }}">{{ link.title }}</a>
                {% endif %}
              </li>
            {% endfor %}
          {% else %}
            <li><a href="/collections/all">Shop All</a></li>
            <li><a href="/collections/perfume">Perfumes</a></li>
            <li><a href="/collections/body-care">Body Care</a></li>
            <li><a href="/collections/sample-sets">Sample Sets</a></li>
          {% endif %}
        </ul>
      </nav>

      <nav class="footer-column" aria-label="About">
        <h2 class="footer-heading">About</h2>
        <ul class="footer-links">
          <li><a href="{{ section.settings.story_page.url | default: '/pages/about-us' }}">Our Story</a></li>
        </ul>
      </nav>

      <nav class="footer-column" aria-label="Help">
        <h2 class="footer-heading">Help</h2>
        <ul class="footer-links">
          <li><a href="{{ section.settings.faq_page.url | default: '/pages/faq' }}">FAQ's</a></li>
          <li><a href="{{ shop.refund_policy.url | default: '/policies/refund-policy' }}">Refunds &amp; Exchange Policy</a></li>
          <li><a href="{{ section.settings.contact_page.url | default: '/pages/contact' }}">Shipping Issues</a></li>
        </ul>
      </nav>

      <div class="footer-column footer-contact">
        <h2 class="footer-heading">Contact</h2>
        <a class="footer-contact__link" href="{{ section.settings.contact_page.url | default: '/pages/contact' }}">Contact Us</a>
        {% if section.settings.location != blank %}<p>{{ section.settings.location }}</p>{% endif %}
      </div>
    </div>

    <div class="footer-bottom">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</span>
      <span>{{ section.settings.bottom_text }}</span>
    </div>
  </div>
</footer>

<style>
  .site-footer.site-footer--expanded {
    background: #f7f2e8;
    color: #16324a;
    padding: clamp(3rem, 6vw, 5rem) 0 1.5rem;
  }

  .site-footer--expanded .footer-grid--expanded {
    grid-template-columns: minmax(220px, 1.5fr) repeat(3, minmax(110px, 0.75fr)) minmax(210px, 1fr);
    gap: clamp(1.5rem, 3vw, 3rem);
    align-items: start;
  }

  .site-footer--expanded .footer-brand__name {
    margin: 0 0 0.75rem;
    color: #16324a;
    font-size: clamp(1.8rem, 3vw, 2.5rem);
  }

  .site-footer--expanded .footer-brand__text {
    max-width: 290px;
    color: rgba(31, 42, 51, 0.76);
  }

  .site-footer--expanded .footer-brand__text p,
  .site-footer--expanded .footer-brand__ownership,
  .site-footer--expanded .footer-contact p {
    margin: 0.6rem 0 0;
  }

  .site-footer--expanded .footer-brand__ownership {
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.05em;
  }

  .site-footer--expanded .footer-heading {
    color: #16324a;
  }

  .site-footer--expanded .footer-links li + li {
    margin-top: 0.35rem;
  }

  .site-footer--expanded .footer-links a,
  .site-footer--expanded .footer-contact a,
  .site-footer--expanded .footer-contact .footer-heading a,
  .site-footer--expanded .footer-socials a {
    color: rgba(31, 42, 51, 0.78);
    text-decoration: none;
  }

  .site-footer--expanded a:hover {
    color: #6d91a8;
  }

  .site-footer--expanded .footer-socials {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
    font-size: 0.88rem;
    font-weight: 700;
  }

  .site-footer--expanded .footer-search-form {
    display: flex;
    flex-wrap: nowrap;
    width: min(240px, 100%);
    height: 36px;
    min-height: 36px;
    max-height: 36px;
    overflow: hidden;
    box-sizing: border-box;
    border: 1px solid rgba(22, 50, 74, .18);
    border-radius: 999px;
    background: #fff;
  }

  .site-footer--expanded .footer-search-form input {
    min-width: 0;
    width: 100%;
    height: 34px !important;
    min-height: 0 !important;
    max-height: 34px !important;
    padding: 0 0 0 11px !important;
    border: 0 !important;
    outline: 0;
    background: transparent;
    color: #16324a;
    font-size: 13px;
    line-height: 1 !important;
    white-space: nowrap;
    box-sizing: border-box;
  }

  .site-footer--expanded .footer-search-form button {
    flex: 0 0 auto;
    height: 34px;
    min-height: 0 !important;
    padding: 0 12px !important;
    border: 0;
    background: #16324a;
    color: #fff;
    cursor: pointer;
    font-size: 12px;
    font-weight: 700;
    line-height: 1;
  }

  .site-footer--expanded .footer-contact {
    overflow-wrap: anywhere;
  }

  .site-footer--expanded .footer-contact p {
    color: rgba(31, 42, 51, 0.68);
    font-size: 0.9rem;
  }

  .site-footer--expanded .footer-bottom {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: rgba(31, 42, 51, 0.66);
    border-top-color: rgba(22, 50, 74, 0.14);
  }

  @media screen and (max-width: 1099px) {
    .site-footer--expanded .footer-grid--expanded {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .site-footer--expanded .footer-brand {
      grid-column: span 2;
    }
  }

  @media screen and (max-width: 749px) {
    .site-footer--expanded .footer-grid--expanded {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2rem 1.25rem;
    }

    .site-footer--expanded .footer-brand,
    .site-footer--expanded .footer-contact {
      grid-column: 1 / -1;
    }

    .site-footer--expanded .footer-bottom {
      flex-direction: column;
    }
  }

  @media screen and (max-width: 420px) {
    .site-footer--expanded .footer-grid--expanded {
      grid-template-columns: 1fr;
    }

    .site-footer--expanded .footer-brand,
    .site-footer--expanded .footer-contact {
      grid-column: auto;
    }
  }
</style>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {"type":"text","id":"heading","label":"Brand heading","default":"JerseyShoreScents"},
    {"type":"richtext","id":"text","label":"Brand description","default":"<p>Handcrafted fragrances and body care.</p>"},
    {"type":"text","id":"ownership_text","label":"Ownership text","default":"Veteran Owned · Woman Owned"},
    {"type":"link_list","id":"shop_menu","label":"Shop menu","default":"footer"},
    {"type":"page","id":"story_page","label":"Our Story page"},
    {"type":"page","id":"faq_page","label":"FAQ page"},
    {"type":"page","id":"contact_page","label":"Contact and shipping issues page"},
    {"type":"text","id":"location","label":"Location","default":"Based in New Jersey"},
    {"type":"text","id":"bottom_text","label":"Bottom text","default":"Veteran Owned · Woman Owned"}
  ]
}
{% endschema %}
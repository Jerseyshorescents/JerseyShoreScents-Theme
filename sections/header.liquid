<header class="site-header">
  {% if section.settings.show_announcement and section.settings.announcement_text != blank %}
    <div class="announcement-bar">
      {{ section.settings.announcement_text }}
    </div>
  {% endif %}

  <div class="page-width header-inner">
    <form class="header-search-form" action="{{ routes.search_url }}" method="get" role="search">
      <label class="visually-hidden" for="HeaderSearch-{{ section.id }}">Search the store</label>
      <input id="HeaderSearch-{{ section.id }}" type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search" autocomplete="off">
      <button type="submit" aria-label="Submit search">⌕</button>
    </form>

    <a class="header-brand" href="{{ routes.root_url }}">
      <span class="header-brand__wave" aria-hidden="true">≈</span>
      <span class="header-brand__name">
        {% if section.settings.logo_text != blank %}
          {{ section.settings.logo_text }}
        {% else %}
          {{ shop.name }}
        {% endif %}
      </span>
    </a>

    <div class="header-actions">
      {% if shop.customer_accounts_enabled %}
        <a href="{{ routes.account_url }}">Account</a>
      {% endif %}
      <a href="{{ routes.cart_url }}">Cart (<span data-cart-count>{{ cart.item_count }}</span>)</a>
    </div>
  </div>

  {% if section.settings.menu != blank %}
    <nav class="header-nav" aria-label="Primary navigation">
      <div class="page-width">
        <ul>
          {% for link in section.settings.menu.links %}
            <li><a href="{{ link.url }}">{{ link.title }}</a></li>
          {% endfor %}
        </ul>
      </div>
    </nav>
  {% endif %}
</header>

<style>
  .header-search-form { display: flex; flex-wrap: nowrap; align-items: center; width: 190px; height: 34px; min-height: 34px; max-height: 34px; overflow: hidden; border: 1px solid rgba(22, 50, 74, .18); border-radius: 999px; background: #fff; box-sizing: border-box; }
  .header-search-form input { min-width: 0; width: 100%; height: 32px !important; min-height: 0 !important; max-height: 32px !important; padding: 0 0 0 11px !important; border: 0 !important; outline: 0; background: transparent; color: #16324a; font: inherit; font-size: 13px; line-height: 1 !important; white-space: nowrap; box-sizing: border-box; }
  .header-search-form button { display: grid; place-items: center; flex: 0 0 34px; width: 34px; height: 32px; min-height: 0 !important; padding: 0 !important; border: 0; background: transparent; color: #16324a; cursor: pointer; font-size: 1rem; line-height: 1; }
  .header-search-form:focus-within { border-color: #6d91a8; box-shadow: 0 0 0 2px rgba(109, 145, 168, .16); }
  @media screen and (max-width: 749px) {
    .header-search-form { width: 36px; height: 34px; min-height: 34px; }
    .header-search-form:focus-within { position: absolute; z-index: 5; left: 1rem; width: min(240px, calc(100vw - 2rem)); }
    .header-search-form input { padding-left: .8rem; }
    .header-search-form:not(:focus-within) input { width: 0; padding-left: 0; }
  }
</style>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Show announcement bar",
      "default": true
    },
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Announcement text",
      "default": "Free shipping on qualifying orders"
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo text",
      "default": "JerseyShoreScents"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    }
  ]
}
{% endschema %}

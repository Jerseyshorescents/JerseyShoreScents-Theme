<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_navy }}">

    <title>
      {{ page_title }}{% if current_tags %} – tagged "{{ current_tags | join: ', ' }}"{% endif %}{% if current_page != 1 %} – Page {{ current_page }}{% endif %}{% unless page_title contains shop.name %} – {{ shop.name }}{% endunless %}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {{ content_for_header }}

    {{ 'theme.css' | asset_url | stylesheet_tag }}
    {{ 'hero.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>
  </head>

  <body>
    <a class="skip-link" href="#MainContent">Skip to content</a>

    {% section 'header' %}

    <main id="MainContent" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% section 'footer' %}

    <div class="cart-notification" data-cart-notification hidden role="status" aria-live="polite" aria-atomic="true">
      <button class="cart-notification__close" type="button" data-cart-notification-close aria-label="Close">×</button>
      <div class="cart-notification__icon" aria-hidden="true">✓</div>
      <div>
        <p class="cart-notification__title" data-cart-notification-title>Added to your cart</p>
        <p class="cart-notification__message" data-cart-notification-message></p>
        <div class="cart-notification__actions">
          <a class="button button--primary" href="{{ routes.cart_url }}">View Cart</a>
          <button class="cart-notification__continue" type="button" data-cart-notification-close>Continue Shopping</button>
        </div>
      </div>
    </div>

  </body>
</html>